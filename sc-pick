#!/usr/bin/env bash
# sc-pick: search SoundCloud, pick tracks or playlists, download them with yt-dlp.
set -euo pipefail

DIR="${SC_PICK_DIR:-$HOME/Music/soundcloud}"
LIMIT="${SC_PICK_LIMIT:-15}"
KIND=tracks
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/sc-pick"
LOG="$DATA/downloaded.tsv"   # date, kind, artist, title, url, folder
ARCHIVE="$DATA/archive.txt"  # yt-dlp archive, so tracks are never fetched twice
TMP=""

usage() {
  cat <<USAGE
usage: sc-pick [-p] [-d folder] [-n limit] [query]
       sc-pick -l

  -p         search playlists instead of tracks
  -d folder  download folder (default: $DIR)
  -n limit   number of results (default: $LIMIT)
  -l         show download log and exit
USAGE
}

show_log() {
  [[ -s "$LOG" ]] || { echo "Nothing downloaded yet."; return; }
  awk -F'\t' '{ printf "%s  %-8s %s — %s\n           -> %s\n", $1, $2, $3, $4, $6 }' "$LOG"
}

while getopts "pd:n:lh" opt; do
  case "$opt" in
    p) KIND=playlists ;;
    d) DIR="$OPTARG" ;;
    n) LIMIT="$OPTARG" ;;
    l) show_log; exit 0 ;;
    *) usage; exit 0 ;;
  esac
done
shift $((OPTIND - 1))

for cmd in soundcloud yt-dlp; do
  command -v "$cmd" >/dev/null || { echo "missing: $cmd (see README)" >&2; exit 1; }
done
mkdir -p "$DATA"
touch "$LOG"
trap '[[ -n "$TMP" ]] && rm -rf "$TMP" && echo "Deleted temporary downloads."' EXIT

download() { # url kind artist title temp
  local url="$1" kind="$2" artist="$3" title="$4" temp="$5" out
  if [[ "$temp" == 1 ]]; then
    [[ -n "$TMP" ]] || TMP="$(mktemp -d -t sc-pick.XXXXXX)"
    out="$TMP"
    yt-dlp -P "$out" -o "%(uploader)s - %(title)s.%(ext)s" "$url" || return 0
    echo "Temporary copy in $out (deleted when you quit)"
  else
    mkdir -p "$DIR"
    out="$DIR"
    [[ "$kind" == playlists ]] && out="$DIR/$artist - $title"
    yt-dlp -P "$out" -o "%(uploader)s - %(title)s.%(ext)s" \
      --download-archive "$ARCHIVE" "$url" || return 0
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %R')" "$kind" "$artist" \
      "$title" "$url" "$out" >>"$LOG"
    echo "Saved to $out"
  fi
}

query="$*"
while :; do
  echo "[$KIND | folder: $DIR]"
  [[ -z "$query" ]] && read -rp "Search: " query
  [[ -z "$query" ]] && exit 0

  if [[ "$KIND" == playlists ]]; then
    fields=title,artist,track_count,url
  else
    fields=title,artist,duration_ms,url
  fi
  mapfile -t rows < <(soundcloud search "$query" --kind "$KIND" -n "$LIMIT" \
    -o tsv --no-header --fields "$fields")
  if (( ${#rows[@]} == 0 )); then
    echo "No results."; query=""; continue
  fi

  urls=() artists=() titles=()
  for i in "${!rows[@]}"; do
    IFS=$'\t' read -r title artist num url <<<"${rows[$i]}"
    urls+=("$url") artists+=("$artist") titles+=("$title")
    mark="  "
    cut -f5 "$LOG" | grep -qxF "$url" && mark="✓ "
    if [[ "$KIND" == playlists ]]; then
      info="$num tracks"
    else
      info="$(printf '%d:%02d' "$((num / 60000))" "$((num / 1000 % 60))")"
    fi
    printf '%s%3d) %s — %s [%s]\n' "$mark" "$((i + 1))" "$artist" "$title" "$info"
  done
  echo "✓ = already downloaded"

  lastq="$query" query=""
  while :; do
    read -rp "Pick (1 3 = download, t2 = temporary, s = search, p = tracks/playlists, f = folder, l = log, q = quit): " -a picks
    case "${picks[0]:-q}" in
      q) exit 0 ;;
      s) continue 2 ;;
      l) show_log; continue ;;
      p) [[ "$KIND" == tracks ]] && KIND=playlists || KIND=tracks; query="$lastq"; continue 2 ;;
      f)
        read -rep "Folder: " -i "$DIR" newdir
        [[ -n "$newdir" ]] && DIR="${newdir/#\~/$HOME}"
        echo "Downloading to $DIR"; continue ;;
    esac
    for pick in "${picks[@]}"; do
      temp=0
      [[ "$pick" == t* ]] && temp=1 && pick="${pick#t}"
      if [[ "$pick" =~ ^[0-9]+$ ]] && (( pick >= 1 && pick <= ${#urls[@]} )); then
        n=$((pick - 1))
        download "${urls[$n]}" "$KIND" "${artists[$n]}" "${titles[$n]}" "$temp"
      else
        echo "skipping invalid choice: $pick" >&2
      fi
    done
  done
done
