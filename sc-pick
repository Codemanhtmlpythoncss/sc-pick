#!/usr/bin/env bash
# sc-pick: search SoundCloud, save local likes, and download authorized tracks with sdownload.
set -euo pipefail

DIR="${SC_PICK_DIR:-$HOME/Music/soundcloud}"
LIMIT="${SC_PICK_LIMIT:-15}"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/sc-pick"
LOG="$DATA/downloaded.tsv"   # date, kind, artist, title, url, folder
LIKES="$DATA/liked.tsv"      # kind, artist, title, info, url
ARCHIVE="$DATA/archive.txt"  # shared sdownload archive, so tracks are never fetched twice
TMP=""
START=menu

usage() {
  cat <<USAGE
usage: sc-pick [-p] [-k] [-d folder] [-n limit] [query]
       sc-pick -l

  -p         search playlists instead of tracks
  -k         open your liked list
  -d folder  download folder (default: $DIR)
  -n limit   number of results (default: $LIMIT)
  -l         show download log and exit

Use the arrow keys (or j/k) to move, Enter to choose, q or Esc to go back.
USAGE
}

show_log() {
  [[ -s "$LOG" ]] || { echo "Nothing downloaded yet."; return; }
  awk -F'\t' '{ printf "%s  %-9s %s — %s\n           -> %s\n", $1, $2, $3, $4, $6 }' "$LOG"
}

while getopts "pkd:n:lh" opt; do
  case "$opt" in
    p) START=playlists ;;
    k) START=likes ;;
    d) DIR="$OPTARG" ;;
    n) LIMIT="$OPTARG" ;;
    l) show_log; exit 0 ;;
    *) usage; exit 0 ;;
  esac
done
shift $((OPTIND - 1))
if [[ $# -gt 0 && "$START" == menu ]]; then START=tracks; fi

# Search and playback helpers are installed into $DATA. Downloads use the user's sdownload command.
BIN="$DATA/bin"
export PATH="$BIN:$DATA/go/bin:$HOME/go/bin:/usr/local/go/bin:$PATH"
mkdir -p "$BIN"

platform() {
  local os arch
  os="$(uname -s | tr '[:upper:]' '[:lower:]')"
  case "$(uname -m)" in
    x86_64|amd64)  arch=amd64 ;;
    aarch64|arm64) arch=arm64 ;;
    armv6l|armv7l) arch=armv6l ;;
    *) echo "unsupported CPU: $(uname -m)" >&2; exit 1 ;;
  esac
  echo "$os $arch"
}

install_go() {
  local os arch ver
  read -r os arch <<<"$(platform)"
  ver="$(curl -fsSL 'https://go.dev/VERSION?m=text' | head -1)"
  echo "Installing $ver..."
  rm -rf "$DATA/go"
  curl -fsSL "https://go.dev/dl/$ver.$os-$arch.tar.gz" | tar -C "$DATA" -xz
}

install_soundcloud() {
  command -v go >/dev/null || install_go
  echo "Installing soundcloud-cli..."
  GOBIN="$BIN" go install github.com/tamnd/soundcloud-cli/cmd/soundcloud@latest
}

install_ytdlp() {
  local os arch file
  read -r os arch <<<"$(platform)"
  case "$os-$arch" in
    linux-amd64)  file=yt-dlp_linux ;;
    linux-arm64)  file=yt-dlp_linux_aarch64 ;;
    linux-armv6l) file=yt-dlp_linux_armv7l ;;
    darwin-*)     file=yt-dlp_macos ;;
    *) echo "no yt-dlp build for $os-$arch" >&2; exit 1 ;;
  esac
  echo "Installing yt-dlp..."
  curl -fsSL "https://github.com/yt-dlp/yt-dlp/releases/latest/download/$file" -o "$BIN/yt-dlp"
  chmod +x "$BIN/yt-dlp"
}

command -v curl >/dev/null || { echo "missing: curl (sudo apt install curl)" >&2; exit 1; }
command -v sdownload >/dev/null || { echo "missing: sdownload (install it on this computer first)" >&2; exit 1; }
if ! sdownload --help 2>&1 | grep -q -- '--output-dir' || ! sdownload --help 2>&1 | grep -q -- '--archive-file'; then
  echo "sdownload is too old for sc-pick. Update it to a version with --output-dir and --archive-file support." >&2
  exit 1
fi
command -v soundcloud >/dev/null || install_soundcloud
command -v yt-dlp >/dev/null || install_ytdlp
touch "$LOG" "$LIKES"

cleanup() {
  tput cnorm 2>/dev/null || true
  if [[ -n "$TMP" ]]; then rm -rf "$TMP"; echo "Deleted temporary downloads."; fi
}
trap cleanup EXIT

# ── Arrow-key menu ──────────────────────────────────────────────────────────
# menu TITLE START_INDEX ITEM... ; sets PICK to the chosen index, or -1 for back.
PICK=-1
menu() {
  local title="$1" sel="$2" key rest top=0 rows cols i line
  shift 2
  local items=("$@") n=$#
  (( sel >= n )) && sel=$((n - 1))
  (( sel < 0 )) && sel=0
  tput civis
  while :; do
    rows=$(( $(tput lines) - 4 )); (( rows < 3 )) && rows=3
    cols=$(tput cols)
    (( sel < top )) && top=$sel
    (( sel >= top + rows )) && top=$((sel - rows + 1))
    printf '\e[H\e[2J\e[1m%s\e[0m\n\n' "$title"
    for (( i = top; i < n && i < top + rows; i++ )); do
      line="${items[$i]:0:$((cols - 4))}"
      if (( i == sel )); then printf '\e[7m > %s \e[0m\n' "$line"; else printf '   %s\n' "$line"; fi
    done
    printf '\n\e[2m↑/↓ move   Enter choose   q back\e[0m'
    IFS= read -rsn1 key || true
    if [[ "$key" == $'\e' ]]; then
      IFS= read -rsn2 -t 0.05 rest || true
      key+="$rest"
    fi
    case "$key" in
      $'\e[A'|k) sel=$(( sel > 0 ? sel - 1 : n - 1 )) ;;
      $'\e[B'|j) sel=$(( sel < n - 1 ? sel + 1 : 0 )) ;;
      "") PICK=$sel; break ;;
      q|$'\e') PICK=-1; break ;;
    esac
  done
  tput cnorm
  printf '\e[H\e[2J'
}

pause() { printf '\n\e[2mPress Enter to continue\e[0m'; read -r _ || true; }

# ── Actions ─────────────────────────────────────────────────────────────────
download() { # url kind artist title temp
  local url="$1" kind="$2" artist="$3" title="$4" temp="$5" out errf rc=0
  if [[ "$temp" == 1 ]]; then
    [[ -n "$TMP" ]] || TMP="$(mktemp -d "${TMPDIR:-/tmp}/sc-pick.XXXXXX")"
    out="$TMP"
  else
    out="$DIR"
    [[ "$kind" == playlists ]] && out="$DIR/$artist - $title"
    if is_downloaded "$url"; then
      echo "Already downloaded: $artist — $title"
      return 0
    fi
  fi
  mkdir -p "$out"
  errf="$(mktemp)"
  echo "Downloading: $artist — $title"
  if [[ "$temp" == 1 ]]; then
    sdownload --output-dir "$out" "$url" 2>&1 | tee "$errf" || rc=$?
  else
    sdownload --output-dir "$out" --archive-file "$ARCHIVE" "$url" 2>&1 | tee "$errf" || rc=$?
  fi
  if grep -q "DRM protected" "$errf"; then
    echo
    echo "✗ SoundCloud only streams this track encrypted (DRM), so it can't be downloaded."
    echo "  If it's your track: turn on 'Enable direct downloads' in the track's"
    echo "  settings on soundcloud.com, then try again — that gets the original file."
  elif (( rc != 0 )); then
    echo; echo "✗ Download failed."
  elif [[ "$temp" == 1 ]]; then
    echo; echo "✓ Temporary copy in $out (deleted when you quit)"
  else
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %R')" "$kind" "$artist" \
      "$title" "$url" "$out" >>"$LOG"
    echo; echo "✓ Saved to $out"
  fi
  rm -f "$errf"
}

# Stream with mpv (which uses yt-dlp), installing it if needed.
ensure_player() {
  command -v mpv >/dev/null && return 0
  echo "Installing mpv to play audio..."
  if command -v apt-get >/dev/null; then
    sudo apt-get install -y mpv
  elif command -v brew >/dev/null; then
    brew install mpv
  fi
  command -v mpv >/dev/null || { echo "✗ Couldn't install mpv — install it yourself to play songs."; return 1; }
}

play() { # url...
  ensure_player || return 0
  echo "Space = pause   ←/→ = seek   > = next   q = stop"
  echo
  local errf rc=0
  errf="$(mktemp)"
  mpv --no-video --really-quiet --term-osd-bar --msg-level=all=error \
    --script-opts="ytdl_hook-ytdl_path=$(command -v yt-dlp)" "$@" 2>"$errf" || rc=$?
  if (( rc != 0 )) || [[ -s "$errf" ]]; then
    echo
    cat "$errf"
    if grep -q "DRM" "$errf"; then
      echo "✗ This track is DRM protected, so it can't be played here."
    elif grep -qiE "audio output|\bao\b|alsa|pulse|pipewire" "$errf"; then
      echo "✗ No sound device found. Plug in speakers/headphones, or run sc-pick on your computer."
    elif (( rc != 0 )); then
      echo "✗ Playback failed (error above)."
    fi
    pause
  fi
  rm -f "$errf"
}

is_liked() { cut -f5 "$LIKES" | grep -qxF "$1"; }
is_downloaded() { cut -f5 "$LOG" | grep -qxF "$1"; }

like() { # index
  printf '%s\t%s\t%s\t%s\t%s\n' "${kinds[$1]}" "${artists[$1]}" "${titles[$1]}" \
    "${infos[$1]}" "${urls[$1]}" >>"$LIKES"
}

unlike() { # index
  awk -F'\t' -v u="${urls[$1]}" '$5 != u' "$LIKES" >"$LIKES.new" && mv "$LIKES.new" "$LIKES"
}

# ── Result lists ────────────────────────────────────────────────────────────
urls=() artists=() titles=() kinds=() infos=()

load_search() { # kind query
  local kind="$1" query="$2" fields row title artist num url info
  urls=() artists=() titles=() kinds=() infos=()
  if [[ "$kind" == playlists ]]; then fields=title,artist,track_count,url; else fields=title,artist,duration_ms,url; fi
  echo "Searching for \"$query\"..."
  while IFS= read -r row; do
    IFS=$'\t' read -r title artist num url <<<"$row"
    if [[ "$kind" == playlists ]]; then
      info="$num tracks"
    else
      info="$(printf '%d:%02d' "$((num / 60000))" "$((num / 1000 % 60))")"
    fi
    kinds+=("$kind") artists+=("$artist") titles+=("$title") infos+=("$info") urls+=("$url")
  done < <(soundcloud search "$query" --kind "$kind" -n "$LIMIT" -o tsv --no-header --fields "$fields")
}

load_likes() {
  local kind artist title info url
  urls=() artists=() titles=() kinds=() infos=()
  while IFS=$'\t' read -r kind artist title info url; do
    kinds+=("$kind") artists+=("$artist") titles+=("$title") infos+=("$info") urls+=("$url")
  done <"$LIKES"
}

# Show the current list; Enter on an item opens its action menu.
browse() { # heading likes(0/1)
  local heading="$1" likes="$2" sel=0 i n mark labels offset
  while :; do
    [[ "$likes" == 1 ]] && load_likes
    if (( ${#urls[@]} == 0 )); then
      if [[ "$likes" == 1 ]]; then echo "No liked songs yet. Open a song and choose Like."; else echo "No results."; fi
      pause; return
    fi
    labels=() offset=0
    if [[ "$likes" == 1 ]]; then labels+=("▶  Play all" "⬇  Download all"); offset=2; fi
    for i in "${!urls[@]}"; do
      mark=""
      is_downloaded "${urls[$i]}" && mark+="✓" || mark+=" "
      is_liked "${urls[$i]}" && mark+="♥" || mark+=" "
      labels+=("$mark ${artists[$i]} — ${titles[$i]} [${infos[$i]}]")
    done
    menu "$heading   (✓ downloaded  ♥ liked)" "$sel" "${labels[@]}"
    (( PICK < 0 )) && return
    sel=$PICK
    if (( offset == 2 && PICK == 0 )); then
      play "${urls[@]}"; continue
    fi
    if (( offset == 2 && PICK == 1 )); then
      for i in "${!urls[@]}"; do
        download "${urls[$i]}" "${kinds[$i]}" "${artists[$i]}" "${titles[$i]}" 0
      done
      pause; continue
    fi
    actions "$((PICK - offset))"
  done
}

actions() { # index
  local n="$1" like_label
  if is_liked "${urls[$n]}"; then like_label="♡  Unlike"; else like_label="♥  Like"; fi
  menu "${artists[$n]} — ${titles[$n]} [${infos[$n]}]" 0 \
    "▶  Play" "⬇  Download to $DIR" "⏱  Temporary download" "$like_label" "←  Back"
  case "$PICK" in
    0) play "${urls[$n]}" ;;
    1) download "${urls[$n]}" "${kinds[$n]}" "${artists[$n]}" "${titles[$n]}" 0; pause ;;
    2) download "${urls[$n]}" "${kinds[$n]}" "${artists[$n]}" "${titles[$n]}" 1; pause ;;
    3) if is_liked "${urls[$n]}"; then unlike "$n"; else like "$n"; fi ;;
  esac
}

search() { # kind [query]
  local kind="$1" query="${2:-}"
  if [[ -z "$query" ]]; then
    read -rp "Search $kind: " query
    [[ -z "$query" ]] && return
  fi
  load_search "$kind" "$query"
  browse "Results for \"$query\" ($kind)" 0
}

# ── Main ────────────────────────────────────────────────────────────────────
case "$START" in
  tracks)    search tracks "$*" ;;
  playlists) search playlists "$*" ;;
  likes)     browse "Liked" 1 ;;
esac

main_sel=0
while :; do
  menu "sc-pick   (folder: $DIR)" "$main_sel" \
    "🔍 Search tracks" "📁 Search playlists" "♥  Liked" "📜 Download log" "📂 Change folder" "✕  Quit"
  (( PICK >= 0 )) && main_sel=$PICK
  case "$PICK" in
    0) search tracks ;;
    1) search playlists ;;
    2) browse "Liked" 1 ;;
    3) show_log; pause ;;
    4)
      read -rep "Folder: " -i "$DIR" newdir
      [[ -n "$newdir" ]] && DIR="${newdir/#\~/$HOME}"
      ;;
    *) exit 0 ;;
  esac
done
