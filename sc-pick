#!/usr/bin/env bash
# sc-pick: search SoundCloud, pick tracks or playlists, download them with yt-dlp.
set -euo pipefail

DIR="${SC_PICK_DIR:-$HOME/Music/soundcloud}"
LIMIT="${SC_PICK_LIMIT:-15}"
KIND=tracks
MODE=search
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/sc-pick"
LOG="$DATA/downloaded.tsv"   # date, kind, artist, title, url, folder
LIKES="$DATA/liked.tsv"      # kind, artist, title, info, url
ARCHIVE="$DATA/archive.txt"  # yt-dlp archive, so tracks are never fetched twice
TMP=""

usage() {
  cat <<USAGE
usage: sc-pick [-p] [-k] [-d folder] [-n limit] [query]
       sc-pick -l

  -p         search playlists instead of tracks
  -k         open your liked list
  -d folder  download folder (default: $DIR)
  -n limit   number of results (default: $LIMIT)
  -l         show download log and exit
USAGE
}

show_log() {
  [[ -s "$LOG" ]] || { echo "Nothing downloaded yet."; return; }
  awk -F'\t' '{ printf "%s  %-8s %s — %s\n           -> %s\n", $1, $2, $3, $4, $6 }' "$LOG"
}

while getopts "pkd:n:lh" opt; do
  case "$opt" in
    p) KIND=playlists ;;
    k) MODE=likes ;;
    d) DIR="$OPTARG" ;;
    n) LIMIT="$OPTARG" ;;
    l) show_log; exit 0 ;;
    *) usage; exit 0 ;;
  esac
done
shift $((OPTIND - 1))

for cmd in soundcloud yt-dlp; do
  command -v "$cmd" >/dev/null || { echo "missing: $cmd (see README)" >&2; exit 1; }
done
mkdir -p "$DATA"
touch "$LOG" "$LIKES"
trap '[[ -n "$TMP" ]] && rm -rf "$TMP" && echo "Deleted temporary downloads."' EXIT

download() { # url kind artist title temp
  local url="$1" kind="$2" artist="$3" title="$4" temp="$5" out
  if [[ "$temp" == 1 ]]; then
    [[ -n "$TMP" ]] || TMP="$(mktemp -d "${TMPDIR:-/tmp}/sc-pick.XXXXXX")"
    out="$TMP"
    yt-dlp -P "$out" -o "%(uploader)s - %(title)s.%(ext)s" "$url" || return 0
    echo "Temporary copy in $out (deleted when you quit)"
  else
    mkdir -p "$DIR"
    out="$DIR"
    [[ "$kind" == playlists ]] && out="$DIR/$artist - $title"
    yt-dlp -P "$out" -o "%(uploader)s - %(title)s.%(ext)s" \
      --download-archive "$ARCHIVE" "$url" || return 0
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %R')" "$kind" "$artist" \
      "$title" "$url" "$out" >>"$LOG"
    echo "Saved to $out"
  fi
}

is_liked() { cut -f5 "$LIKES" | grep -qxF "$1"; }

like() { # index
  local n="$1"
  if is_liked "${urls[$n]}"; then
    echo "Already liked: ${titles[$n]}"
  else
    printf '%s\t%s\t%s\t%s\t%s\n' "${kinds[$n]}" "${artists[$n]}" "${titles[$n]}" \
      "${infos[$n]}" "${urls[$n]}" >>"$LIKES"
    echo "♥ Liked: ${titles[$n]}"
  fi
}

unlike() { # index
  local n="$1"
  awk -F'\t' -v u="${urls[$n]}" '$5 != u' "$LIKES" >"$LIKES.new" && mv "$LIKES.new" "$LIKES"
  echo "Unliked: ${titles[$n]}"
}

show_list() {
  local i mark
  if [[ "$MODE" == likes ]]; then echo "── Liked ──"; else echo "[$KIND | folder: $DIR]"; fi
  for i in "${!urls[@]}"; do
    mark=""
    cut -f5 "$LOG" | grep -qxF "${urls[$i]}" && mark+="✓" || mark+=" "
    is_liked "${urls[$i]}" && mark+="♥" || mark+=" "
    printf '%s %3d) %s — %s [%s]\n' "$mark" "$((i + 1))" "${artists[$i]}" "${titles[$i]}" "${infos[$i]}"
  done
  echo "✓ = downloaded   ♥ = liked"
}

query="$*"
while :; do
  urls=() artists=() titles=() kinds=() infos=()

  if [[ "$MODE" == likes ]]; then
    if [[ ! -s "$LIKES" ]]; then
      echo "No liked songs yet. Like a search result with +number."
      MODE=search; continue
    fi
    while IFS=$'\t' read -r kind artist title info url; do
      kinds+=("$kind") artists+=("$artist") titles+=("$title") infos+=("$info") urls+=("$url")
    done <"$LIKES"
  else
    [[ -z "$query" ]] && echo "[$KIND | folder: $DIR]" && read -rp "Search (k = liked list, q = quit): " query
    case "$query" in
      ""|q) exit 0 ;;
      k) MODE=likes query=""; continue ;;
    esac
    if [[ "$KIND" == playlists ]]; then
      fields=title,artist,track_count,url
    else
      fields=title,artist,duration_ms,url
    fi
    mapfile -t rows < <(soundcloud search "$query" --kind "$KIND" -n "$LIMIT" \
      -o tsv --no-header --fields "$fields")
    lastq="$query" query=""
    if (( ${#rows[@]} == 0 )); then
      echo "No results."; continue
    fi
    for row in "${rows[@]}"; do
      IFS=$'\t' read -r title artist num url <<<"$row"
      if [[ "$KIND" == playlists ]]; then
        info="$num tracks"
      else
        info="$(printf '%d:%02d' "$((num / 60000))" "$((num / 1000 % 60))")"
      fi
      kinds+=("$KIND") artists+=("$artist") titles+=("$title") infos+=("$info") urls+=("$url")
    done
  fi

  show_list
  while :; do
    echo "1 3 = download  t2 = temporary  +2 = like  u2 = unlike  a = download all"
    read -rp "s = search  k = liked  p = tracks/playlists  f = folder  l = log  q = quit: " -a picks
    case "${picks[0]:-q}" in
      q) exit 0 ;;
      s) MODE=search; continue 2 ;;
      k) MODE=likes; continue 2 ;;
      l) show_log; continue ;;
      p)
        [[ "$KIND" == tracks ]] && KIND=playlists || KIND=tracks
        MODE=search query="${lastq:-}"; continue 2 ;;
      f)
        read -rep "Folder: " -i "$DIR" newdir
        [[ -n "$newdir" ]] && DIR="${newdir/#\~/$HOME}"
        echo "Downloading to $DIR"; continue ;;
      a) picks=($(seq 1 "${#urls[@]}")) ;;
    esac
    changed=0
    for pick in "${picks[@]}"; do
      action=get
      case "$pick" in
        t*) action=temp pick="${pick#t}" ;;
        +*) action=like pick="${pick#+}" ;;
        u*) action=unlike pick="${pick#u}" ;;
      esac
      if ! [[ "$pick" =~ ^[0-9]+$ ]] || (( pick < 1 || pick > ${#urls[@]} )); then
        echo "skipping invalid choice: $pick" >&2; continue
      fi
      n=$((pick - 1))
      case "$action" in
        get)    download "${urls[$n]}" "${kinds[$n]}" "${artists[$n]}" "${titles[$n]}" 0 ;;
        temp)   download "${urls[$n]}" "${kinds[$n]}" "${artists[$n]}" "${titles[$n]}" 1 ;;
        like)   like "$n" ;;
        unlike) unlike "$n" ;;
      esac
      changed=1
    done
    # Unliking changes the liked list itself, so reload it; otherwise just redraw marks.
    if [[ "$MODE" == likes && " ${picks[*]} " == *" u"* ]]; then continue 2; fi
    (( changed )) && show_list
  done
done
