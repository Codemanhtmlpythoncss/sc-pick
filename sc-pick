#!/usr/bin/env bash
# sc-pick: search SoundCloud, pick a result, download it with yt-dlp.
set -euo pipefail

DIR="${SC_PICK_DIR:-$HOME/Music/soundcloud}"
LIMIT="${SC_PICK_LIMIT:-15}"

for cmd in soundcloud yt-dlp; do
  command -v "$cmd" >/dev/null || { echo "missing: $cmd (see README)" >&2; exit 1; }
done

query="$*"
while :; do
  [[ -z "$query" ]] && read -rp "Search: " query
  [[ -z "$query" ]] && exit 0

  mapfile -t rows < <(soundcloud search "$query" -n "$LIMIT" -o tsv --no-header \
    --fields title,artist,duration_ms,url)
  if (( ${#rows[@]} == 0 )); then
    echo "No results."; query=""; continue
  fi

  urls=()
  for i in "${!rows[@]}"; do
    IFS=$'\t' read -r title artist ms url <<<"${rows[$i]}"
    urls+=("$url")
    printf '%3d) %s — %s [%d:%02d]\n' "$((i + 1))" "$artist" "$title" \
      "$((ms / 60000))" "$((ms / 1000 % 60))"
  done

  read -rp "Download which? (numbers e.g. 1 3, s = new search, q = quit): " -a picks
  query=""
  case "${picks[0]:-q}" in
    q) exit 0 ;;
    s) continue ;;
  esac

  mkdir -p "$DIR"
  for n in "${picks[@]}"; do
    if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#urls[@]} )); then
      yt-dlp -P "$DIR" -o "%(uploader)s - %(title)s.%(ext)s" "${urls[$((n - 1))]}"
    else
      echo "skipping invalid choice: $n" >&2
    fi
  done
  echo "Saved to $DIR"
done
